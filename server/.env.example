# FleetOS Server Environment Configuration
# Copy this file to `.env` and fill in your values.

# Server port (Vite dev proxy expects 5000)
PORT=5000

# JWT secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# JWT expiry
JWT_EXPIRES_IN=7d

# MongoDB connection string.
# Leave empty to use the built-in in-memory store.
# For a local MongoDB install:  mongodb://127.0.0.1:27017/fleetos
# For MongoDB Atlas (cloud):    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleetos
MONGODB_URI=
