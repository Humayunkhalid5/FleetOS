PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fleetos
# Required in production. Development generates a private persistent secret.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production must set MONGODB_URI to Atlas and must not use this local address.

# Optional social sign-in. A provider's button turns on once both values are set.
# Authorised redirect URIs to register with each provider:
#   Google:   http://localhost:5000/api/auth/oauth/google/callback
#   LinkedIn: http://localhost:5000/api/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Public base URL used to build the callback URLs above (defaults to the API host).
OAUTH_CALLBACK_BASE_URL=
# Where users land after social sign-in (defaults to the first CORS origin).
CLIENT_ORIGIN=http://localhost:5173
