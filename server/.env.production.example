NODE_ENV=production
PORT=5000
# Store this in the deployment provider's secret/environment settings.
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/fleetos?retryWrites=true&w=majority
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_FOR_PRODUCTION
CORS_ORIGINS=https://your-client-domain.example,https://your-admin-domain.example

# Optional social sign-in (Google and LinkedIn OpenID Connect).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=https://api.your-domain.example
CLIENT_ORIGIN=https://app.your-domain.example
